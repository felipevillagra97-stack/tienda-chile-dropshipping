{% comment %}
  Section: veltro-product-showcase.liquid
  Sección CRO de alta conversión para la página de producto de dropshipping.
  Incluye: 4 casos de uso, desglose de kit de accesorios, ficha técnica y testimonios verificados de Chile.
{% endcomment %}

<div class="vshowcase-wrap" id="vshowcase-section">
  <div class="vshowcase-container">

    <!-- BOTÓN DE ACCIÓN RÁPIDA SUPERIOR -->
    <div class="vshowcase-cta-top">
      <a href="#cod-order-form" class="vshowcase-scroll-btn" onclick="scrollToCodForm(event)">
        ⚡ PEDIR AHORA CON PAGO CONTRA ENTREGA • DESPACHO 24-48 HRS
      </a>
    </div>

    <!-- 1. CASOS DE USO / PROBLEMA VS SOLUCIÓN -->
    <div class="vshowcase-block">
      <div class="vshowcase-header">
        <span class="vshowcase-tag">POTENCIA MULTIUSO</span>
        <h2 class="vshowcase-title">Una Sola Herramienta para Todo tu Hogar y tu Vehículo</h2>
        <p class="vshowcase-desc">Desprende grasa, sarro, moho y bacterias en segundos utilizando únicamente vapor a 105°C y 4 BAR de presión, sin gastar en químicos dañinos.</p>
      </div>

      <div class="vshowcase-grid-cards">
        <div class="vcard">
          <div class="vcard-icon-wrap">🍳</div>
          <h3>Cocina y Hornos sin Grasa</h3>
          <p>Disuelve al instante la grasa pegada en campanas extractoras, freidoras de aire, quemadores y hornos sin refregar por horas.</p>
        </div>

        <div class="vcard">
          <div class="vcard-icon-wrap">🚿</div>
          <h3>Baños Libres de Sarro y Moho</h3>
          <p>El calor y la presión penetran en las junturas de cerámicas, shower doors y griferías, eliminando el 99.9% de hongos y bacterias.</p>
        </div>

        <div class="vcard">
          <div class="vcard-icon-wrap">🚗</div>
          <h3>Limpieza Detallada de Auto</h3>
          <p>Limpia tapices manchados, conductos de ventilación, llantas con hollín de frenos y desengrasa partes del motor con precisión.</p>
        </div>

        <div class="vcard">
          <div class="vcard-icon-wrap">🛋️</div>
          <h3>Desinfección de Tapices y Colchones</h3>
          <p>Elimina ácaros, ácaros del polvo, malos olores y manchas en sillones, camas y alfombras. Ideal para casas con niños y mascotas.</p>
        </div>
      </div>
    </div>

    <!-- 2. DESGLOSE DEL KIT DE ACCESORIOS -->
    <div class="vshowcase-block vshowcase-kit-block">
      <div class="vshowcase-header">
        <span class="vshowcase-tag">KIT COMPLETO INCLUIDO</span>
        <h2 class="vshowcase-title">¿Qué Recibes en tu Paquete?</h2>
        <p class="vshowcase-desc">Todo lo necesario para comenzar a limpiar desde el primer minuto sin comprar adaptadores adicionales.</p>
      </div>

      <div class="vkit-list">
        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Unidad Limpiadora a Vapor 2500W</strong>
            <span>Generador de vapor con perilla selectora de 6 intensidades ajustables.</span>
          </div>
        </div>

        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Boquilla Curva de Precisión</strong>
            <span>Diseñada para acceder a esquinas difíciles, ranuras de ventanas y uniones estrechas.</span>
          </div>
        </div>

        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Boquilla Recta de Alta Presión</strong>
            <span>Concentra el chorro de vapor para desincrustar suciedad pesada a máxima fuerza.</span>
          </div>
        </div>

        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Cepillo Circular con Cerdas de Cobre</strong>
            <span>Especial para parrillas, rejillas de horno y restos carbonizados difíciles.</span>
          </div>
        </div>

        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Cepillo Circular Grande de Nylon</strong>
            <span>Ideal para baldosas, cerámicas de baño, azulejos y superficies amplias.</span>
          </div>
        </div>

        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Cepillo Circular Pequeño de Nylon</strong>
            <span>Para juntas finas de cocina, griferías cromadas y botones de electrodomésticos.</span>
          </div>
        </div>

        <div class="vkit-item">
          <div class="vkit-check">✓</div>
          <div class="vkit-text">
            <strong>1x Manguera Térmica Flexible + Cable Extendido</strong>
            <span>Libertad de movimiento de largo alcance con enchufe chileno estándar (220V).</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. ESPECIFICACIONES TÉCNICAS OFICIALES -->
    <div class="vshowcase-block">
      <div class="vshowcase-header">
        <span class="vshowcase-tag">RENDIMIENTO CERTIFICADO</span>
        <h2 class="vshowcase-title">Especificaciones Técnicas</h2>
      </div>

      <div class="vspecs-card">
        <table class="vspecs-table-grid">
          <tbody>
            <tr>
              <td class="vspecs-label">Potencia Máxima:</td>
              <td class="vspecs-val">2.500 Watts de alto rendimiento</td>
            </tr>
            <tr>
              <td class="vspecs-label">Presión de Trabajo:</td>
              <td class="vspecs-val">4.0 BAR de presión constante</td>
            </tr>
            <tr>
              <td class="vspecs-label">Temperatura de Salida:</td>
              <td class="vspecs-val">105°C (Desinfección térmica antibacteriana)</td>
            </tr>
            <tr>
              <td class="vspecs-label">Tiempo de Calentamiento:</td>
              <td class="vspecs-val">15 segundos ultra rápido</td>
            </tr>
            <tr>
              <td class="vspecs-label">Capacidad de Estanque:</td>
              <td class="vspecs-val">1.0 Litro con reposición continua</td>
            </tr>
            <tr>
              <td class="vspecs-label">Regulación de Vapor:</td>
              <td class="vspecs-val">Perilla rotativa con 6 niveles de intensidad</td>
            </tr>
            <tr>
              <td class="vspecs-label">Voltaje Compatible:</td>
              <td class="vspecs-val">220V - 50Hz (Enchufe para Chile)</td>
            </tr>
            <tr>
              <td class="vspecs-label">Garantía Oficial:</td>
              <td class="vspecs-val">30 días de respaldo directo VELTRO Chile</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 4. TESTIMONIOS Y RESEÑAS VERIFICADAS DE CHILE -->
    <div class="vshowcase-block">
      <div class="vshowcase-header">
        <span class="vshowcase-tag">CLIENTES SATISFECHOS EN CHILE</span>
        <h2 class="vshowcase-title">Opiniones Reales de Compradores</h2>
        <p class="vshowcase-desc">Valoración promedio de <strong>4.9 / 5.0</strong> basada en más de 360 entregas realizadas en todo Chile.</p>
      </div>

      <div class="vreviews-grid">
        <div class="vreview-item">
          <div class="vreview-top">
            <div class="vreview-user">
              <strong>Isabella L.</strong>
              <span class="vreview-loc">📍 Viña del Mar, Región de Valparaíso</span>
            </div>
            <span class="vreview-badge">✓ Compra Verificada</span>
          </div>
          <div class="vreview-stars">⭐⭐⭐⭐⭐</div>
          <p class="vreview-comment">"Me llegó en 2 días por Blue Express. Lo probé altiro en el sillón del living que tenía manchas antiguas de café y de mis gatos. Con el vapor se fueron soltando super rápido y quedó impecable. También lo ocupé en la cocina y saca la grasa de la campana sin frotar casi nada. 100% recomendado."</p>
        </div>

        <div class="vreview-item">
          <div class="vreview-top">
            <div class="vreview-user">
              <strong>Sebastian F.</strong>
              <span class="vreview-loc">📍 Santiago Centro, Región Metropolitana</span>
            </div>
            <span class="vreview-badge">✓ Compra Verificada</span>
          </div>
          <div class="vreview-stars">⭐⭐⭐⭐⭐</div>
          <p class="vreview-comment">"Lo compré principalmente para hacerle limpieza profunda al auto y terminó siendo la mejor compra del año para la casa. El vapor caliente afloja toda la mugre de los rieles de ventanas y las juntas del baño que estaban negras. Pagué en efectivo al recibir, cero problemas."</p>
        </div>

        <div class="vreview-item">
          <div class="vreview-top">
            <div class="vreview-user">
              <strong>Santiago C.</strong>
              <span class="vreview-loc">📍 Concepción, Región del Biobío</span>
            </div>
            <span class="vreview-badge">✓ Compra Verificada</span>
          </div>
          <div class="vreview-stars">⭐⭐⭐⭐⭐</div>
          <p class="vreview-comment">"Probé limpiadores químicos de todo tipo y ninguno sacaba el sarro acumulado del shower door. Con esta máquina a vapor salió todo en 10 minutos. El repartidor de Starken muy amable, le transferí con mi CuentaRUT al recibir la caja. El producto viene muy completo con todos sus accesorios."</p>
        </div>
      </div>
    </div>

    <!-- BOTÓN FINAL DE CONVERSIÓN CON SCROLL SUAVE -->
    <div class="vshowcase-cta-bottom">
      <div class="vcta-card">
        <h3>¿Listo para limpiar más rápido y sin químicos?</h3>
        <p>Aprovecha la promoción de hoy con <strong>Envío Gratis a todo Chile</strong> y <strong>Pago al Recibir en tu Puerta</strong>.</p>
        <a href="#cod-order-form" class="vshowcase-scroll-btn-large" onclick="scrollToCodForm(event)">
          🚚 PEDIR AHORA • PAGA AL RECIBIR EN CASA
        </a>
        <div class="vcta-guarantee">
          <span>🛡️ Garantía de 30 Días</span> • <span>📦 Despacho 24-48 hrs</span> • <span>🇨🇱 Stock en Bodega Santiago</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function scrollToCodForm(e) {
    if (e) e.preventDefault();
    var target = document.getElementById('cod-order-form') || document.querySelector('.chile-cod-box') || document.getElementById('chile-cod-box');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      var nameInput = document.getElementById('cod_name') || document.getElementById('vl_name');
      if (nameInput) {
        setTimeout(function() { nameInput.focus(); }, 450);
      }
    }
  }
</script>

<style>
  .vshowcase-wrap {
    background-color: #F8FAFC;
    padding: 30px 16px 50px 16px;
    color: #1E293B;
    font-family: inherit;
  }
  .vshowcase-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .vshowcase-cta-top {
    text-align: center;
    margin-bottom: 35px;
  }
  .vshowcase-scroll-btn {
    display: inline-block;
    background: #16A34A;
    color: #FFFFFF !important;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    padding: 13px 26px;
    border-radius: 30px;
    box-shadow: 0 4px 15px rgba(22, 163, 74, 0.35);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .vshowcase-scroll-btn:hover {
    background: #15803D;
    transform: translateY(-2px);
  }
  .vshowcase-block {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 32px 24px;
    margin-bottom: 28px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }
  .vshowcase-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 28px auto;
  }
  .vshowcase-tag {
    display: inline-block;
    background: #EFF6FF;
    color: #2563EB;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  .vshowcase-title {
    font-size: 24px;
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }
  .vshowcase-desc {
    font-size: 14px;
    color: #64748B;
    line-height: 1.5;
    margin: 0;
  }

  /* 4 Tarjetas de Usos */
  .vshowcase-grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }
  .vcard {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 20px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .vcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
    border-color: #CBD5E1;
  }
  .vcard-icon-wrap {
    font-size: 28px;
    margin-bottom: 12px;
  }
  .vcard h3 {
    font-size: 15px;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 8px 0;
  }
  .vcard p {
    font-size: 13px;
    color: #475569;
    line-height: 1.45;
    margin: 0;
  }

  /* Kit de Accesorios */
  .vkit-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .vkit-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #F8FAFC;
    padding: 14px 16px;
    border-radius: 8px;
    border: 1px solid #F1F5F9;
  }
  .vkit-check {
    width: 22px;
    height: 22px;
    background: #DCFCE7;
    color: #16A34A;
    font-weight: 900;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }
  .vkit-text strong {
    display: block;
    font-size: 13px;
    color: #0F172A;
    margin-bottom: 2px;
  }
  .vkit-text span {
    font-size: 12px;
    color: #64748B;
    line-height: 1.35;
  }

  /* Tabla de Especificaciones */
  .vspecs-card {
    background: #F8FAFC;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #E2E8F0;
  }
  .vspecs-table-grid {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .vspecs-table-grid tr {
    border-bottom: 1px solid #E2E8F0;
  }
  .vspecs-table-grid tr:last-child {
    border-bottom: none;
  }
  .vspecs-label {
    padding: 12px 18px;
    font-weight: 700;
    color: #334155;
    width: 38%;
    background: #F1F5F9;
  }
  .vspecs-val {
    padding: 12px 18px;
    color: #0F172A;
    font-weight: 600;
  }

  /* Reseñas Chile */
  .vreviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .vreview-item {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 18px;
  }
  .vreview-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  .vreview-user strong {
    display: block;
    font-size: 14px;
    color: #0F172A;
  }
  .vreview-loc {
    font-size: 11px;
    color: #64748B;
  }
  .vreview-badge {
    background: #DCFCE7;
    color: #15803D;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 12px;
  }
  .vreview-stars {
    font-size: 13px;
    margin-bottom: 8px;
  }
  .vreview-comment {
    font-size: 13px;
    color: #334155;
    line-height: 1.45;
    margin: 0;
    font-style: italic;
  }

  /* CTA Inferior */
  .vshowcase-cta-bottom {
    text-align: center;
    margin-top: 15px;
  }
  .vcta-card {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    color: #FFFFFF;
    padding: 36px 20px;
    border-radius: 14px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.15);
  }
  .vcta-card h3 {
    font-size: 22px;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 10px 0;
  }
  .vcta-card p {
    font-size: 14px;
    color: #94A3B8;
    margin: 0 0 22px 0;
  }
  .vshowcase-scroll-btn-large {
    display: inline-block;
    background: #16A34A;
    color: #FFFFFF !important;
    text-decoration: none;
    font-weight: 900;
    font-size: 16px;
    padding: 16px 36px;
    border-radius: 40px;
    box-shadow: 0 6px 20px rgba(22, 163, 74, 0.4);
    transition: transform 0.2s, background 0.2s;
    animation: vctaPulse 2.2s infinite;
  }
  @keyframes vctaPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.03); }
    100% { transform: scale(1); }
  }
  .vshowcase-scroll-btn-large:hover {
    background: #15803D;
  }
  .vcta-guarantee {
    margin-top: 16px;
    font-size: 12px;
    color: #CBD5E1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .vshowcase-title {
      font-size: 20px;
    }
    .vshowcase-grid-cards,
    .vkit-list,
    .vreviews-grid {
      grid-template-columns: 1fr;
    }
    .vspecs-label {
      width: 45%;
      padding: 10px 12px;
    }
    .vspecs-val {
      padding: 10px 12px;
    }
    .vshowcase-scroll-btn-large {
      font-size: 14px;
      padding: 14px 24px;
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Showcase Producto Chile",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Showcase Producto Chile"
    }
  ]
}
{% endschema %}
