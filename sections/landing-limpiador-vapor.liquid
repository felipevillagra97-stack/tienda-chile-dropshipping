    background: #FFF7ED;
  }
  .vapor-ribbon {
    position: absolute;
    top: -9px;
    right: 12px;
    background: #F97316;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 10px;
  }
  .vapor-ribbon-best {
    position: absolute;
    top: -9px;
    right: 12px;
    background: #16A34A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 10px;
  }
