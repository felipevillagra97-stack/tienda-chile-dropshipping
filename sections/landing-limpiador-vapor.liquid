    flex-direction: column;
    font-size: 13px;
  }
  .vapor-free-ship {
    color: #16A34A;
    font-weight: 700;
    font-size: 11px;
  }
  .vapor-save-tag {
    color: #DC2626;
    font-weight: 700;
    font-size: 11px;
  }
