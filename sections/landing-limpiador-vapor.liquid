    font-weight: 800;
    color: #374151;
    margin-bottom: 8px;
    letter-spacing: 0.4px;
  }
  .vapor-bundle-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .vapor-bundle-opt {
