<section class="veltro-trust-section" id="trust-{{ section.id }}">
  <div class="veltro-trust-container">
    <div class="veltro-trust-grid">
      
      <!-- PILLAR 1: DESPACHO -->
      <div class="veltro-trust-card">
        <div class="veltro-trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="veltro-trust-text">
          <h4 class="veltro-trust-title">{{ section.settings.p1_title | default: 'Envíos a Todo Chile' }}</h4>
          <p class="veltro-trust-desc">{{ section.settings.p1_desc | default: 'Despacho rápido 24-48 hrs con Blue Express y Starken.' }}</p>
        </div>
      </div>

      <!-- PILLAR 2: PAGO CONTRA ENTREGA -->
      <div class="veltro-trust-card">
        <div class="veltro-trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div class="veltro-trust-text">
          <h4 class="veltro-trust-title">{{ section.settings.p2_title | default: 'Paga al Recibir en Casa' }}</h4>
          <p class="veltro-trust-desc">{{ section.settings.p2_desc | default: 'Paga en efectivo o transferencia cuando llegue tu paquete.' }}</p>
        </div>
      </div>

      <!-- PILLAR 3: GARANTÍA -->
      <div class="veltro-trust-card">
        <div class="veltro-trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="veltro-trust-text">
          <h4 class="veltro-trust-title">{{ section.settings.p3_title | default: 'Garantía de Satisfacción' }}</h4>
          <p class="veltro-trust-desc">{{ section.settings.p3_desc | default: '30 días de respaldo oficial. Compra 100% garantizada.' }}</p>
        </div>
      </div>

      <!-- PILLAR 4: ATENCIÓN WHATSAPP -->
      <div class="veltro-trust-card">
        <div class="veltro-trust-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="veltro-trust-text">
          <h4 class="veltro-trust-title">{{ section.settings.p4_title | default: 'Soporte vía WhatsApp' }}</h4>
          <p class="veltro-trust-desc">{{ section.settings.p4_desc | default: 'Atención personalizada para resolver todas tus dudas.' }}</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .veltro-trust-section {
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 24px 16px;
    width: 100%;
  }
  .veltro-trust-container {
    max-width: 1300px;
    margin: 0 auto;
  }
  .veltro-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .veltro-trust-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 12px;
  }
  .veltro-trust-icon-box {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #EFF6FF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .veltro-trust-title {
    font-size: 14px;
    font-weight: 700;
    color: #030712;
    margin: 0 0 3px 0;
    line-height: 1.2;
  }
  .veltro-trust-desc {
    font-size: 12px;
    color: #6B7280;
    margin: 0;
    line-height: 1.3;
  }
  @media (max-width: 990px) {
    .veltro-trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 550px) {
    .veltro-trust-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .veltro-trust-card {
      padding: 6px 8px;
    }
  }
</style>

