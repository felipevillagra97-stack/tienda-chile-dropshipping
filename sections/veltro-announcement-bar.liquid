<div class="veltro-ticker-bar" id="ticker-{{ section.id }}">
  <div class="veltro-ticker-track">
    <div class="veltro-ticker-content">
      <span class="veltro-ticker-item">🇨🇱 <span class="veltro-hl">ENVÍOS A TODO CHILE</span> • ENTREGA RÁPIDA 24 A 48 HORAS</span>
      <span class="veltro-ticker-dot">•</span>
      <span class="veltro-ticker-item">💵 <span class="veltro-hl">PAGA AL RECIBIR</span> EN TU CASA (PAGO CONTRA ENTREGA)</span>
      <span class="veltro-ticker-dot">•</span>
      <span class="veltro-ticker-item">🛡️ GARANTÍA DE SATISFACCIÓN 100% • COMPRA SEGURA</span>
      <span class="veltro-ticker-dot">•</span>
      <span class="veltro-ticker-item">🔥 <span class="veltro-hl">STOCK LIMITADO</span> EN BODEGA SANTIAGO</span>
      <span class="veltro-ticker-dot">•</span>
      <!-- REPETICIÓN PARA LOOP INFINITO CONTINUO -->
      <span class="veltro-ticker-item">🇨🇱 <span class="veltro-hl">ENVÍOS A TODO CHILE</span> • ENTREGA RÁPIDA 24 A 48 HORAS</span>
      <span class="veltro-ticker-dot">•</span>
      <span class="veltro-ticker-item">💵 <span class="veltro-hl">PAGA AL RECIBIR</span> EN TU CASA (PAGO CONTRA ENTREGA)</span>
      <span class="veltro-ticker-dot">•</span>
      <span class="veltro-ticker-item">🛡️ GARANTÍA DE SATISFACCIÓN 100% • COMPRA SEGURA</span>
      <span class="veltro-ticker-dot">•</span>
      <span class="veltro-ticker-item">🔥 <span class="veltro-hl">STOCK LIMITADO</span> EN BODEGA SANTIAGO</span>
      <span class="veltro-ticker-dot">•</span>
    </div>
  </div>
</div>

<style>
  .veltro-ticker-bar {
    background: {{ section.settings.bg_color | default: '#030712' }};
    color: #FFFFFF;
    overflow: hidden;
    white-space: nowrap;
    height: 38px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    position: relative;
    z-index: 1001;
  }
  .veltro-ticker-track {
    display: flex;
    width: max-content;
    animation: veltroTicker {{ section.settings.speed | default: 28 }}s linear infinite;
  }
  .veltro-ticker-content {
    display: flex;
    align-items: center;
  }
  .veltro-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .veltro-hl {
    color: {{ section.settings.hl_color | default: '#38BDF8' }};
  }
  .veltro-ticker-dot {
    color: rgba(255, 255, 255, 0.3);
    font-size: 13px;
  }
  .veltro-ticker-bar:hover .veltro-ticker-track {
    animation-play-state: paused;
  }
  @keyframes veltroTicker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "Barra Anuncios Ticker",
  "tag": "section",
  "class": "section-veltro-announcement",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de Fondo",
      "default": "#030712"
    },
    {
      "type": "color",
      "id": "hl_color",
      "label": "Color de Énfasis",
      "default": "#38BDF8"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Velocidad de Desplazamiento",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Barra Anuncios Ticker Veltro"
    }
  ]
}
{% endschema %}
