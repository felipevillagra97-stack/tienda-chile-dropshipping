{% comment %}
  Section: veltro-promo-product-banner.liquid
  Banner destacado de alta conversión para el producto estrella: Limpiadora a Vapor 2500W.
  Incluye imagen panorámica, detalles de oferta, precio en CLP, botones de compra contra entrega y sellos de Chile.
{% endcomment %}

<section class="veltro-promo-section" id="promo-banner-{{ section.id }}">
  <div class="veltro-promo-container">
    
    <!-- ENCABEZADO DE OFERTA -->
    <div class="promo-badge-wrap">
      <span class="promo-badge-pulse"></span>
      <span class="promo-badge-title">{{ section.settings.badge_text | default: '⚡ OFERTA DESTACADA DE LA SEMANA • STOCK EN BODEGA SANTIAGO' }}</span>
    </div>

    <!-- IMAGEN PANORÁMICA DEL PRODUCTO (DE TU PC) -->
    <div class="promo-image-wrapper">
      <a href="{{ section.settings.btn_link | default: '#landing-vapor-section' }}" class="promo-img-link" onclick="if(document.getElementById('landing-vapor-section')){event.preventDefault();document.getElementById('landing-vapor-section').scrollIntoView({behavior:'smooth'});}">
        {%- if section.settings.promo_image != blank -%}
          <img
            src="{{ section.settings.promo_image | image_url: width: 2400 }}"
            alt="{{ section.settings.heading | default: 'Limpiadora a Vapor 2500W' }}"
            class="promo-banner-img"
            loading="lazy"
            width="{{ section.settings.promo_image.width }}"
            height="{{ section.settings.promo_image.height }}"
          >
        {%- else -%}
          <img
            src="{{ 'banner-limpiador-vapor.png' | asset_url }}"
            alt="Limpiadora a Vapor Multifuncional 2500W 4 BAR"
            class="promo-banner-img"
            loading="lazy"
            width="1983"
            height="793"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- TARJETA DE OFERTA Y BOTONES DE COMPRA DIRECTA -->
    <div class="promo-offer-card">
      <div class="promo-info-col">
        <div class="promo-rating-row">
          <span class="promo-stars">⭐⭐⭐⭐⭐</span>
          <span class="promo-reviews"><strong>4.9 / 5.0</strong> (+362 compradores en Chile)</span>
        </div>
        <h2 class="promo-heading">{{ section.settings.heading | default: 'Limpiadora a Vapor Multifuncional 2500W + 6 Accesorios' }}</h2>
        <p class="promo-subheading">{{ section.settings.subheading | default: 'Disuelve grasa quemada, hongos en junturas de baño y suciedad en motores de auto en segundos con vapor continuo a 105°C y 4 BAR de presión. Sin químicos dañinos.' }}</p>

        <div class="promo-bullets">
          <div class="promo-bullet-item">
            <span class="bullet-check">✓</span>
            <span><strong>Vapor a 105°C:</strong> Desinfecta el 99.9% de bacterias y ácaros.</span>
          </div>
          <div class="promo-bullet-item">
            <span class="bullet-check">✓</span>
            <span><strong>Incluye 6 boquillas y cepillos:</strong> Para cocina, sillones, alfombras y auto.</span>
          </div>
          <div class="promo-bullet-item">
            <span class="bullet-check">✓</span>
            <span><strong>Envío 100% Gratis a Todo Chile:</strong> Despacho express por Blue Express y Starken.</span>
          </div>
        </div>
      </div>

      <div class="promo-action-col">
        <div class="promo-price-box">
          <div class="promo-price-tag">
            <span class="promo-price-current">{{ section.settings.price | default: '$42.990' }}</span>
            <span class="promo-price-old">{{ section.settings.old_price | default: '$53.990' }}</span>
            <span class="promo-discount-badge">20% OFF</span>
          </div>
          <p class="promo-shipping-notice">🚚 <strong>Pagas al Recibir en Casa</strong> (Efectivo o Transferencia)</p>
        </div>

        <!-- BOTONES DE COMPRA -->
        <div class="promo-cta-buttons">
          <a href="{{ section.settings.btn_link | default: '#landing-vapor-section' }}" class="btn-promo-buy" onclick="if(document.getElementById('landing-vapor-section')){event.preventDefault();document.getElementById('landing-vapor-section').scrollIntoView({behavior:'smooth'});}">
            <span class="btn-buy-main">🚚 PEDIR AHORA • PAGA AL RECIBIR</span>
            <span class="btn-buy-sub">Pagas únicamente cuando recibas el paquete en tus manos</span>
          </a>

          <a href="https://wa.me/56912345678?text=Hola%20VELTRO,%20quiero%20hacer%20un%20pedido%20de%20la%20Limpiadora%20a%20Vapor%202500W%20con%20Pago%20Contra%20Entrega" target="_blank" class="btn-promo-whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Pedir por WhatsApp Directo</span>
          </a>
        </div>

        <div class="promo-guarantee-tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Garantía Oficial VELTRO de 30 Días</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .veltro-promo-section {
    padding: 40px 16px;
    background: #030712;
    color: #FFFFFF;
    width: 100%;
  }
  .veltro-promo-container {
    max-width: 1300px;
    margin: 0 auto;
  }
  .promo-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(37, 99, 235, 0.2);
    border: 1px solid #2563EB;
    border-radius: 20px;
    padding: 6px 16px;
    margin-bottom: 20px;
  }
  .promo-badge-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38BDF8;
    box-shadow: 0 0 8px #38BDF8;
  }
  .promo-badge-title {
    font-size: 12px;
    font-weight: 800;
    color: #38BDF8;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .promo-image-wrapper {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 28px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .promo-img-link {
    display: block;
    width: 100%;
    line-height: 0;
  }
  .promo-banner-img {
    width: 100% !important;
    height: auto !important;
    display: block;
    object-fit: cover;
  }
  .promo-offer-card {
    background: #111827;
    border: 1px solid #1F2937;
    border-radius: 14px;
    padding: 30px;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    align-items: center;
  }
  .promo-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  .promo-reviews {
    font-size: 13px;
    color: #9CA3AF;
  }
  .promo-reviews strong {
    color: #FFFFFF;
  }
  .promo-heading {
    font-size: 26px;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 12px 0;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }
  .promo-subheading {
    font-size: 14px;
    color: #9CA3AF;
    line-height: 1.5;
    margin: 0 0 20px 0;
  }
  .promo-bullets {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .promo-bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: #E5E7EB;
  }
  .bullet-check {
    color: #10B981;
    font-weight: 900;
  }
  .promo-action-col {
    background: #1F2937;
    border-radius: 12px;
    padding: 24px;
    border: 1px solid #374151;
  }
  .promo-price-box {
    margin-bottom: 20px;
    text-align: center;
  }
  .promo-price-tag {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
  }
  .promo-price-current {
    font-size: 32px;
    font-weight: 900;
    color: #38BDF8;
  }
  .promo-price-old {
    font-size: 18px;
    color: #9CA3AF;
    text-decoration: line-through;
  }
  .promo-discount-badge {
    background: #DC2626;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .promo-shipping-notice {
    margin: 8px 0 0 0;
    font-size: 12px;
    color: #10B981;
  }
  .promo-cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .btn-promo-buy {
    background: #16A34A;
    color: #FFFFFF;
    text-decoration: none;
    padding: 14px 18px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: background 0.2s, transform 0.1s;
    box-shadow: 0 6px 15px rgba(22, 163, 74, 0.4);
  }
  .btn-promo-buy:hover {
    background: #15803D;
    transform: translateY(-2px);
  }
  .btn-buy-main {
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.3px;
  }
  .btn-buy-sub {
    font-size: 11px;
    opacity: 0.9;
    margin-top: 3px;
  }
  .btn-promo-whatsapp {
    background: #25D366;
    color: #FFFFFF;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    transition: background 0.2s;
  }
  .btn-promo-whatsapp:hover {
    background: #1EBE5D;
  }
  .promo-guarantee-tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 12px;
    color: #9CA3AF;
  }
  @media (max-width: 900px) {
    .promo-offer-card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 20px;
    }
    .promo-heading {
      font-size: 22px;
    }
  }
</style>

{% schema %}
{
  "name": "Banner Producto Estrella",
  "tag": "section",
  "class": "section-veltro-promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Imagen Panorámica del Producto",
      "info": "Por defecto muestra la imagen horizontal de la Limpiadora a Vapor 2500W."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del Distintivo Superior",
      "default": "⚡ OFERTA DESTACADA DE LA SEMANA • STOCK EN BODEGA SANTIAGO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título del Producto",
      "default": "Limpiadora a Vapor Multifuncional 2500W + 6 Accesorios"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Descripción Corta",
      "default": "Disuelve grasa quemada, hongos en junturas de baño y suciedad en motores de auto en segundos con vapor continuo a 105°C y 4 BAR de presión."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Precio Oferta",
      "default": "$42.990"
    },
    {
      "type": "text",
      "id": "old_price",
      "label": "Precio Habitual",
      "default": "$53.990"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Enlace del Botón de Compra",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Banner Producto Estrella Veltro"
    }
  ]
}
{% endschema %}
