    assign kit_item_5 = '✓ 1x Cepillo circular grande de nylon'
    assign kit_item_6 = '✓ 1x Cepillo circular pequeño de precisión y manguera térmica'

    assign specs_title = 'Ficha Técnica Oficial'
    assign spec_1_k = 'Potencia Eléctrica'
    assign spec_1_v = '2.500 Watts de alto rendimiento'
    assign spec_2_k = 'Presión de Trabajo'
    assign spec_2_v = '4 BAR constantes'
    assign spec_3_k = 'Temperatura de Vapor'
    assign spec_3_v = '105°C (Desinfección antibacteriana)'
    assign spec_4_k = 'Regulación'
    assign spec_4_v = '6 niveles de potencia ajustable'
    assign spec_5_k = 'Voltaje'
    assign spec_5_v = '220V (Enchufe estándar chileno)'
    assign spec_6_k = 'Garantía'
    assign spec_6_v = '30 días con respaldo oficial VELTRO Chile'

  else
    assign p_badge = '🌿 FÓRMULA BOTÁNICA 2 EN 1 • SIN AMONÍACO • RESULTADOS EN 10 MIN'
    assign p_rating_text = '4.9 / 5.0 • +520 clientes satisfechos en Chile'
    assign p_title = 'Shampoo Colorante Negro 2 en 1 con Colágeno y Aceite de Argán'
    assign p_desc = 'Cubre el 100% de las canas en solo 10 a 15 minutos durante la ducha. Fórmula nutritiva que no mancha la piel ni el cuero cabelludo. Apto para cabello, barba y bigote tanto en hombres como mujeres.'
    
    assign p_price_1 = '$22.990'
    assign p_old_price_1 = '$32.990'
    assign p_discount_tag = '30% DESCUENTO'
    assign p_stock_left = '8 unidades'
    assign p_unit_1 = '1x Botella Familiar Shampoo Colorante + Guantes'
    
    assign p_price_2 = '$36.990'
    assign p_old_price_2 = '$45.980'
    assign p_sub_2 = '($18.495 c/u)'
    assign p_save_2 = 'Ahorras $8.990 (Tratamiento Semestral)'
    assign p_unit_2 = '2x Botellas Familiares (Tratamiento para 6 meses)'

    assign p_price_3 = '$49.990'
    assign p_old_price_3 = '$68.970'
    assign p_sub_3 = '($16.663 c/u)'
    assign p_save_3 = 'Ahorras $18.980 (Pack Ahorro Familiar)'
    assign p_unit_3 = '3x Botellas (Pack Ahorro Familiar)'

    assign sol_title = 'Cobertura Total de Canas sin Químicos Agresivos'
    assign sol_subtitle = 'Ahorra más de $150.000 al año en peluquerías tiñéndote tú mismo en la ducha'
    assign sol_1_icon = '⏱️'
    assign sol_1_title = 'Resultados Rápidos en 10-15 Minutos'
    assign sol_1_desc = 'Aplícalo como un shampoo normal en la ducha, deja actuar de 10 a 15 minutos y enjuaga con agua. Canas 100% negras al instante.'
    assign sol_2_icon = '💧'
    assign sol_2_title = 'Nutrición con Colágeno y Argán'
    assign sol_2_desc = 'A diferencia de las tinturas comunes que queman y resecan, este shampoo fortalece la fibra capilar, previene la caída y deja un brillo sedoso.'
    assign sol_3_icon = '🚫'
    assign sol_3_title = 'Cero Manchas en Frente y Cuero Cabelludo'
    assign sol_3_desc = 'Fórmula inteligente de base botánica que se adhiere selectivamente a la queratina capilar sin manchar tu piel, orejas ni manos.'
    assign sol_4_icon = '🧔'
    assign sol_4_title = 'Ideal para Cabello, Barba y Bigote'
