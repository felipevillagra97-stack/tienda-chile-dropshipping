    assign spec_2_v = 'Luz infrarroja calmante (aprox. 40°C - 45°C)'
    assign spec_3_k = 'Nodos de Masaje'
    assign spec_3_v = '8 cabezales rotatorios con 3 niveles de velocidad'
    assign spec_4_k = 'Temporizador'
    assign spec_4_v = 'Apagado automático inteligente a los 15 minutos'
    assign spec_5_k = 'Alimentación'
    assign spec_5_v = '220V (Hogar) + 12V (Auto) - Ambos cables incluidos'
