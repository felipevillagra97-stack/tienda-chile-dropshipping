{% comment %}
  Section: landing-shampoo.liquid
  Landing CRO dedicada para: Shampoo Colorante Negro Max Belle 2 en 1 con Colágeno y Argán
  Dropshipping Chile con Pago Contra Entrega (COD)
{% endcomment %}

{%- liquid
  assign handle = product.handle | default: '' | downcase
  assign title_lower = product.title | default: '' | downcase

  if handle contains 'masaje' or title_lower contains 'masaje' or title_lower contains 'cuello'
    assign prod_type = 'masaje'
