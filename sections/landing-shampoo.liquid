<script>
  function switchVaporImg(src, thumbEl) {
    document.getElementById('vapor-main-img').src = src;
    document.querySelectorAll('.vapor-thumb').forEach(function(t) { t.classList.remove('active'); });
    thumbEl.classList.add('active');
  }

  var currentVaporQty = 1;
  var currentVaporTotal = "{{ p_price_1 }}";
  var unit1Text = "{{ p_unit_1 }}";
  var unit2Text = "{{ p_unit_2 }}";
  var unit3Text = "{{ p_unit_3 }}";
  var productTitle = "{% if is_masaje %}Masajeador de Cuello y Espalda Shiatsu 3D{% else %}Shampoo Colorante Negro 2 en 1 con Argán{% endif %}";

  function selectVaporBundle(qty, total, el) {
    document.querySelectorAll('.vapor-bundle-opt').forEach(function(o) { o.classList.remove('active'); });
    el.classList.add('active');
    var r = el.querySelector('input[type="radio"]');
    if (r) r.checked = true;

    currentVaporQty = qty;
    currentVaporTotal = total;

    var nameText = qty === 1 ? unit1Text : (qty === 2 ? unit2Text : unit3Text);
    document.getElementById('vsum-name').textContent = nameText;
    document.getElementById('vsum-total-val').textContent = total;
  }

  function submitVaporLandingOrder() {
    var name = document.getElementById('vl_name').value.trim();
    var phone = document.getElementById('vl_phone').value.trim();
    var region = document.getElementById('vl_region').value;
    var city = document.getElementById('vl_city').value.trim();
    var address = document.getElementById('vl_address').value.trim();
    var payMethod = document.querySelector('input[name="vl_pay"]:checked')?.value || 'Efectivo al recibir';

    if (!name || !phone || !region || !city || !address) {
      alert('Por favor completa todos los campos requeridos para tu entrega.');
      return;
    }

    var btn = document.getElementById('vl_submit_btn');
    btn.disabled = true;
    btn.textContent = 'Procesando orden...';

    var waMsg = "¡Hola VELTRO! Acabo de hacer un pedido con Pago Contra Entrega en www.veltro.cl:%0A%0A"
      + "📦 *Producto:* " + encodeURIComponent(productTitle) + "%0A"
      + "🔢 *Cantidad:* " + currentVaporQty + " unid.%0A"
      + "💰 *Total a pagar:* " + encodeURIComponent(currentVaporTotal) + "%0A"
      + "💵 *Medio de Pago:* " + encodeURIComponent(payMethod) + "%0A"
      + "👤 *Nombre:* " + encodeURIComponent(name) + "%0A"
      + "📞 *Teléfono:* +56 " + encodeURIComponent(phone) + "%0A"
      + "📍 *Región:* " + encodeURIComponent(region) + "%0A"
      + "🏙️ *Comuna:* " + encodeURIComponent(city) + "%0A"
      + "🏠 *Dirección:* " + encodeURIComponent(address) + "%0A%0A"
      + "¿Me pueden confirmar cuándo sale el despacho con Blue Express / Starken? ¡Muchas gracias!";

    document.getElementById('vapor-landing-form').style.display = 'none';
    var succ = document.getElementById('vl-success');
    succ.style.display = 'block';
    document.getElementById('vl-wa-link').href = "https://wa.me/56912345678?text=" + waMsg;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: {{ product.selected_or_first_available_variant.id | default: product.variants.first.id | default: 0 }},
        quantity: currentVaporQty,
        properties: {
          'Modalidad': 'Pago Contra Entrega (COD)',
          'Nombre Cliente': name,
          'Teléfono': '+56 ' + phone,
          'Región': region,
          'Comuna': city,
          'Dirección': address,
          'Medio Pago': payMethod
        }
      })
    }).catch(function(e) { console.log('Cart notification', e); });
  }
</script>

