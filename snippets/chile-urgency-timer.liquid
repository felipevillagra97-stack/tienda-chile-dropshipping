{% comment %}
  Snippet: chile-urgency-timer.liquid
  Barra de urgencia sutil con contador regresivo y unidades restantes en bodega.
  Aumenta la tasa de conversión sin verse invasivo.
{% endcomment %}

<div class="chile-urgency-box" style="margin: {{ block.settings.margin_top | default: 12 }}px 0 {{ block.settings.margin_bottom | default: 12 }}px 0; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; padding: 10px 14px;">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
    <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #b45309;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>{{ block.settings.timer_text | default: '¡Oferta especial por tiempo limitado!' }}</span>
    </div>

    <div style="display: flex; align-items: center; gap: 4px; font-weight: 700; font-size: 14px; color: #92400e; font-family: monospace;">
      <span id="chile-countdown-min">14</span>m :
      <span id="chile-countdown-sec">59</span>s
    </div>
  </div>

  {% if block.settings.show_stock_bar %}
    <div style="margin-top: 8px;">
      <div style="display: flex; justify-content: space-between; font-size: 11px; color: #78350f; font-weight: 600; margin-bottom: 4px;">
        <span>{{ block.settings.stock_label | default: 'Unidades en bodega Santiago:' }}</span>
        <strong style="color: #dc2626;">{{ block.settings.stock_left | default: '7 unidades' }}</strong>
      </div>
      <div style="width: 100%; height: 6px; background-color: #fde68a; border-radius: 3px; overflow: hidden;">
        <div style="width: {{ block.settings.stock_percentage | default: 22 }}%; height: 100%; background: linear-gradient(90deg, #f59e0b, #ef4444); border-radius: 3px;"></div>
      </div>
    </div>
  {% endif %}
</div>

<script>
(function() {
  var minutes = {{ block.settings.duration_minutes | default: 15 }};
  var seconds = 0;
  var totalSeconds = minutes * 60;

  var minEl = document.getElementById('chile-countdown-min');
  var secEl = document.getElementById('chile-countdown-sec');

  if (minEl && secEl) {
    var timer = setInterval(function() {
      if (totalSeconds <= 0) {
        clearInterval(timer);
        return;
      }
      totalSeconds--;
      var m = Math.floor(totalSeconds / 60);
      var s = totalSeconds % 60;
      minEl.textContent = (m < 10 ? '0' : '') + m;
      secEl.textContent = (s < 10 ? '0' : '') + s;
    }, 1000);
  }
})();
</script>
