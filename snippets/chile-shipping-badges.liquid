{% comment %}
  Snippet: chile-shipping-badges.liquid
  Muestra los transportistas de mayor confianza y cobertura en Chile: Blue Express, Starken y Chilexpress.
  Incluye texto de garantía de despacho con número de seguimiento en línea.
{% endcomment %}

<div class="chile-shipping-badges-wrapper" style="margin: {{ block.settings.margin_top | default: 15 }}px 0 {{ block.settings.margin_bottom | default: 15 }}px 0; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px;">
  <div style="display: flex; align-items: flex-start; gap: 10px;">
    <div style="flex-shrink: 0; margin-top: 2px;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <div style="flex-grow: 1;">
      <div style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 3px;">
        {{ block.settings.heading | default: 'Envíos Rápidos y Seguros a Todo Chile' }}
      </div>
      <p style="margin: 0 0 8px 0; font-size: 12px; color: #475569; line-height: 1.4;">
        {{ block.settings.subheading | default: 'Despachamos de 24 a 48 hrs hábiles con número de seguimiento en línea.' }}
      </p>

      <div class="chile-couriers-logos" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
        {% comment %} Blue Express {% endcomment %}
        <div title="Blue Express" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 3px 8px; height: 26px;">
          <svg width="65" height="18" viewBox="0 0 130 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="130" height="36" rx="4" fill="#002b66"/>
            <text x="12" y="24" fill="#00a3e0" font-size="14" font-family="Arial, sans-serif" font-weight="900">blue</text>
            <text x="50" y="24" fill="#ffffff" font-size="13" font-family="Arial, sans-serif" font-weight="bold">express</text>
          </svg>
        </div>

        {% comment %} Starken {% endcomment %}
        <div title="Starken" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 3px 8px; height: 26px;">
          <svg width="60" height="18" viewBox="0 0 110 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="110" height="36" rx="4" fill="#facc15"/>
            <text x="55" y="24" fill="#0284c7" font-size="16" font-family="Arial, sans-serif" font-weight="900" font-style="italic" text-anchor="middle">starken</text>
          </svg>
        </div>

        {% comment %} Chilexpress {% endcomment %}
        <div title="Chilexpress" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 3px 8px; height: 26px;">
          <svg width="70" height="18" viewBox="0 0 125 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="125" height="36" rx="4" fill="#eab308"/>
            <text x="62" y="23" fill="#881337" font-size="12" font-family="Arial, sans-serif" font-weight="900" font-style="italic" text-anchor="middle">CHILEXPRESS</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>
