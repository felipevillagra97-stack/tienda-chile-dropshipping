{% comment %}
  Snippet: chile-payment-badges.liquid
  Muestra los métodos de pago de mayor confianza en Chile: Webpay Plus, Redcompra, Mercado Pago, CuentaRUT y MACH.
  Optimizado para CRO y velocidad de carga con SVGs vectoriales ultraligeros.
{% endcomment %}

<div class="chile-payment-badges-wrapper" style="margin: {{ block.settings.margin_top | default: 15 }}px 0 {{ block.settings.margin_bottom | default: 15 }}px 0;">
  {% if block.settings.heading != blank %}
    <div class="chile-badges-title" style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 8px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>{{ block.settings.heading | default: 'Pago 100% Seguro y Encriptado' }}</span>
    </div>
  {% endif %}

  <div class="chile-badges-grid" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
    {% comment %} Webpay Plus {% endcomment %}
    <div class="chile-badge-card" title="Webpay Plus Transbank" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; height: 32px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
      <svg width="60" height="20" viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="120" height="40" rx="6" fill="#002b49"/>
        <path d="M14 26L10 14H13L15.5 22.5L18 14H21L23.5 22.5L26 14H29L25 26H22L19.5 17.5L17 26H14Z" fill="#ffffff"/>
        <path d="M36 21.5C36 24 34.2 26 31.5 26C28.8 26 27 24 27 21.5C27 19 28.8 17 31.5 17C34.2 17 36 19 36 21.5ZM29.8 21.5C29.8 23 30.5 24 31.5 24C32.5 24 33.2 23 33.2 21.5C33.2 20 32.5 19 31.5 19C30.5 19 29.8 20 29.8 21.5Z" fill="#ffffff"/>
        <path d="M38 11H40.8V26H38V11Z" fill="#ffffff"/>
        <path d="M48 21.5C48 24 46.2 26 43.5 26C41.5 26 40.2 25 39.8 24.2V29H37V17.3H39.8V18.8C40.2 18 41.5 17 43.5 17C46.2 17 48 19 48 21.5ZM45.2 21.5C45.2 20 44.5 19 43.5 19C42.5 19 41.8 20 41.8 21.5C41.8 23 42.5 24 43.5 24C44.5 24 45.2 23 45.2 21.5Z" fill="#ffffff"/>
        <path d="M54 26C52.5 26 51.5 25.4 51.1 24.2L53.5 23.2C53.7 23.8 54.2 24.1 54.8 24.1C55.4 24.1 55.8 23.9 55.8 23.5C55.8 23.1 55.4 22.8 54.6 22.6L53.6 22.3C52.2 21.9 51.4 21 51.4 19.8C51.4 18.2 52.8 17 54.6 17C56.2 17 57.3 17.7 57.8 18.8L55.5 19.8C55.3 19.3 54.8 19 54.3 19C53.7 19 53.3 19.2 53.3 19.6C53.3 20 53.7 20.2 54.5 20.4L55.5 20.7C57 21.2 57.9 22.1 57.9 23.4C57.9 25 56.4 26 54 26Z" fill="#ffffff"/>
        <rect x="64" y="10" width="48" height="20" rx="3" fill="#ff5000"/>
        <text x="88" y="24" fill="#ffffff" font-size="11" font-family="Arial, sans-serif" font-weight="bold" text-anchor="middle">PLUS</text>
      </svg>
    </div>

    {% comment %} Redcompra {% endcomment %}
    <div class="chile-badge-card" title="Redcompra" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; height: 32px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
      <svg width="60" height="20" viewBox="0 0 110 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="110" height="36" rx="5" fill="#f8fafc"/>
        <rect x="4" y="4" width="48" height="28" rx="4" fill="#e11d48"/>
        <rect x="58" y="4" width="48" height="28" rx="4" fill="#2563eb"/>
        <text x="28" y="22" fill="#ffffff" font-size="10" font-family="Arial, sans-serif" font-weight="900" text-anchor="middle">RED</text>
        <text x="82" y="22" fill="#ffffff" font-size="9" font-family="Arial, sans-serif" font-weight="bold" text-anchor="middle">COMPRA</text>
      </svg>
    </div>

    {% comment %} Mercado Pago {% endcomment %}
    <div class="chile-badge-card" title="Mercado Pago" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; height: 32px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
      <svg width="70" height="20" viewBox="0 0 120 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="120" height="36" rx="5" fill="#009ee3"/>
        <circle cx="20" cy="18" r="10" fill="#ffffff"/>
        <path d="M15 17C16 15 18 15 20 16.5C22 15 24 15 25 17" stroke="#009ee3" stroke-width="1.8" stroke-linecap="round"/>
        <text x="68" y="22" fill="#ffffff" font-size="10" font-family="Arial, sans-serif" font-weight="bold" text-anchor="middle">mercado pago</text>
      </svg>
    </div>

    {% comment %} BancoEstado / CuentaRUT {% endcomment %}
    <div class="chile-badge-card" title="CuentaRUT BancoEstado" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; height: 32px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
      <svg width="68" height="20" viewBox="0 0 115 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="115" height="36" rx="5" fill="#f97316"/>
        <circle cx="16" cy="18" r="9" fill="#ffffff"/>
        <path d="M13 18L15 20L19 15" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="64" y="22" fill="#ffffff" font-size="10" font-family="Arial, sans-serif" font-weight="bold" text-anchor="middle">CuentaRUT</text>
      </svg>
    </div>

    {% comment %} MACH {% endcomment %}
    <div class="chile-badge-card" title="MACH Bci" style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; height: 32px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
      <svg width="55" height="20" viewBox="0 0 90 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="90" height="36" rx="5" fill="#6c2bd9"/>
        <text x="45" y="23" fill="#00e5a3" font-size="14" font-family="Arial, sans-serif" font-weight="900" letter-spacing="1" text-anchor="middle">MACH</text>
      </svg>
    </div>
  </div>

  {% if block.settings.show_subtitle %}
    <p style="margin: 6px 0 0 0; font-size: 11px; color: #6b7280; line-height: 1.4;">
      {{ block.settings.subtitle | default: 'Aceptamos tarjetas de débito, crédito y transferencias bancarias en Chile.' }}
    </p>
  {% endif %}
</div>
