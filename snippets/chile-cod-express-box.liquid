{% comment %}
  Snippet: chile-cod-express-box.liquid
  Formulario y Bloque de Pago Contra Entrega de Alta Conversión para Dropshipping en Chile.
  Permite al cliente realizar su pedido con pago al recibir (Efectivo o Transferencia al repartidor).
{% endcomment %}

<div class="chile-cod-box" id="chile-cod-box-{{ product.id }}">
  
  <!-- CABECERA DE CONFIANZA Y ALERTA -->
  <div class="cod-header-badge">
    <span class="cod-pulse-dot"></span>
    <span class="cod-header-text">🇨🇱 PAGO CONTRA ENTREGA DISPONIBLE • PAGA EN TU CASA</span>
  </div>

  <div class="cod-sub-header">
    <p>🚚 Despachos diarios a todo Chile vía <strong>Blue Express</strong> y <strong>Starken</strong>. Pides hoy y pagas únicamente cuando el repartidor llegue a tu puerta.</p>
  </div>

  <!-- SELECTOR DE OFERTAS POR CANTIDAD (BUNDLES DE ALTA CONVERSIÓN) -->
  <div class="cod-bundles-wrapper">
    <div class="cod-bundle-title">Elige tu oferta con Descuento:</div>

    <div class="cod-bundle-options">
      <!-- OFERTA 1: 1 UNIDAD -->
      <label class="cod-bundle-card active" data-qty="1" data-discount="0">
        <input type="radio" name="cod_bundle" value="1" checked>
        <div class="cod-bundle-details">
          <div class="cod-bundle-name">
            <strong>1 Unidad</strong>
            <span class="cod-tag-free">Envío Gratis</span>
          </div>
          <div class="cod-bundle-pricing">
            <span class="cod-price" id="bundle-price-1">{{ product.price | money }}</span>
          </div>
        </div>
      </label>

      <!-- OFERTA 2: 2 UNIDADES (20% OFF) -->
      <label class="cod-bundle-card popular" data-qty="2" data-discount="20">
        <div class="cod-ribbon-popular">MÁS VENDIDO 🔥</div>
        <input type="radio" name="cod_bundle" value="2">
        <div class="cod-bundle-details">
          <div class="cod-bundle-name">
            <strong>Lleva 2 Unidades</strong>
            <span class="cod-tag-discount">Ahorra 20%</span>
          </div>
          <div class="cod-bundle-pricing">
            <span class="cod-price" id="bundle-price-2">{{ product.price | times: 1.6 | round: 0 | money }}</span>
            <span class="cod-old-price">{{ product.price | times: 2 | money }}</span>
          </div>
        </div>
      </label>

      <!-- OFERTA 3: 3 UNIDADES (35% OFF) -->
      <label class="cod-bundle-card" data-qty="3" data-discount="35">
        <div class="cod-ribbon-value">MEJOR VALOR ⭐</div>
        <input type="radio" name="cod_bundle" value="3">
        <div class="cod-bundle-details">
          <div class="cod-bundle-name">
            <strong>Lleva 3 Unidades</strong>
            <span class="cod-tag-discount">Ahorra 35%</span>
          </div>
          <div class="cod-bundle-pricing">
            <span class="cod-price" id="bundle-price-3">{{ product.price | times: 1.95 | round: 0 | money }}</span>
            <span class="cod-old-price">{{ product.price | times: 3 | money }}</span>
          </div>
        </div>
      </label>
    </div>
  </div>

  <!-- FORMULARIO DE ENVÍO DIRECTO PARA CHILE -->
  <form id="cod-order-form" class="cod-form" onsubmit="event.preventDefault(); submitChileCodOrder();">
    <div class="cod-form-heading">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span>Datos para el Envío y Entrega</span>
    </div>

    <!-- NOMBRE -->
    <div class="cod-field-group">
      <label for="cod_name">Nombre y Apellido *</label>
      <input type="text" id="cod_name" name="name" required placeholder="Ej: Juan Pérez" autocomplete="name">
    </div>

    <!-- TELÉFONO -->
    <div class="cod-field-group">
      <label for="cod_phone">Teléfono / WhatsApp de Contacto *</label>
      <div class="cod-phone-input">
        <span class="cod-prefix">+56</span>
        <input type="tel" id="cod_phone" name="phone" required placeholder="9 1234 5678" maxlength="12" autocomplete="tel">
      </div>
      <small>Te contactaremos por WhatsApp para coordinar la entrega.</small>
    </div>

    <!-- REGIÓN -->
    <div class="cod-field-group">
      <label for="cod_region">Región de Entrega *</label>
      <select id="cod_region" name="region" required>
        <option value="" disabled selected>Selecciona tu región...</option>
        <option value="Región Metropolitana">Región Metropolitana de Santiago</option>
        <option value="Valparaíso">Región de Valparaíso</option>
        <option value="Biobío">Región del Biobío</option>
        <option value="Coquimbo">Región de Coquimbo</option>
        <option value="Antofagasta">Región de Antofagasta</option>
        <option value="O'Higgins">Región de O'Higgins</option>
        <option value="Maule">Región del Maule</option>
        <option value="La Araucanía">Región de La Araucanía</option>
        <option value="Los Lagos">Región de Los Lagos</option>
        <option value="Tarapacá">Región de Tarapacá</option>
        <option value="Atacama">Región de Atacama</option>
        <option value="Los Ríos">Región de Los Ríos</option>
        <option value="Arica y Parinacota">Región de Arica y Parinacota</option>
        <option value="Ñuble">Región de Ñuble</option>
        <option value="Aysén">Región de Aysén</option>
        <option value="Magallanes">Región de Magallanes</option>
      </select>
    </div>

    <!-- COMUNA -->
    <div class="cod-field-group">
      <label for="cod_city">Comuna / Ciudad *</label>
      <input type="text" id="cod_city" name="city" required placeholder="Ej: Las Condes, Maipú, Viña del Mar, Concepción...">
    </div>

    <!-- DIRECCIÓN -->
    <div class="cod-field-group">
      <label for="cod_address">Dirección de Entrega (Calle, Número, Depto/Casa) *</label>
      <input type="text" id="cod_address" name="address" required placeholder="Ej: Av. Providencia 1234, Depto 502" autocomplete="street-address">
    </div>

    <!-- MÉTODO DE PAGO AL RECIBIR -->
    <div class="cod-field-group">
      <label>¿Cómo pagarás al recibir el producto? *</label>
      <div class="cod-payment-choices">
        <label class="cod-payment-opt">
          <input type="radio" name="payment_method" value="Efectivo al Repartidor" checked>
          <span>💵 Efectivo al repartidor</span>
        </label>
        <label class="cod-payment-opt">
          <input type="radio" name="payment_method" value="Transferencia Bancaria al Recibir">
          <span>📱 Transferencia al recibir (CuentaRUT / Banco)</span>
        </label>
      </div>
    </div>

    <!-- RESUMEN FINAL -->
    <div class="cod-summary-box">
      <div class="cod-summary-row">
        <span>Producto:</span>
        <strong id="cod-summary-product">{{ product.title }}</strong>
      </div>
      <div class="cod-summary-row">
        <span>Cantidad:</span>
        <strong id="cod-summary-qty">1 unidad</strong>
      </div>
      <div class="cod-summary-row">
        <span>Costo de Envío:</span>
        <strong class="cod-free-text">¡GRATIS A TODO CHILE! 🎉</strong>
      </div>
      <div class="cod-summary-total">
        <span>Total a Pagar en tu Puerta:</span>
        <span class="cod-total-price" id="cod-total-display">{{ product.price | money }}</span>
      </div>
    </div>

    <!-- BOTÓN FINAL DE COMPRA -->
    <button type="submit" class="cod-submit-btn" id="cod-submit-btn">
      <span class="cod-btn-title">🚚 PEDIR AHORA • PAGA AL RECIBIR</span>
      <span class="cod-btn-sub">Pagas únicamente cuando recibas el paquete en tus manos</span>
    </button>

    <div class="cod-guarantee-note">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span>Compra 100% Protegida • Garantía de Satisfacción de 30 Días</span>
    </div>
  </form>

  <!-- MENSAJE DE ÉXITO TRAS COMPLETAR PEDIDO -->
  <div id="cod-success-message" style="display: none;" class="cod-success-card">
    <div class="cod-success-icon">🎉</div>
    <h3>¡Tu Pedido ha sido Recibido con Éxito!</h3>
    <p>Hemos registrado tu orden para <strong>pago contra entrega</strong>.</p>
    <div class="cod-success-box">
      <p>Nos pondremos en contacto vía WhatsApp al número indicado para confirmar el despacho por <strong>Blue Express / Starken</strong>.</p>
    </div>
    <a id="cod-whatsapp-confirm-link" href="#" target="_blank" class="cod-whatsapp-btn">
      📲 Enviar confirmación por WhatsApp ahora
    </a>
  </div>

</div>

<style>
  .chile-cod-box {
    background: #FFFFFF;
    border: 2px solid #2563EB;
    border-radius: 12px;
    padding: 20px;
    margin: 18px 0;
    box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.12);
  }
  .cod-header-badge {
    background: #EFF6FF;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 800;
    color: #1E40AF;
    margin-bottom: 10px;
  }
  .cod-pulse-dot {
    width: 8px;
    height: 8px;
    background: #2563EB;
    border-radius: 50%;
    animation: codPulse 1.8s infinite;
  }
  @keyframes codPulse {
    0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.6); }
    70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(37, 99, 235, 0); }
    100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
  }
  .cod-sub-header p {
    font-size: 13px;
    color: #4B5563;
    line-height: 1.45;
    margin: 0 0 16px 0;
  }
  .cod-bundles-wrapper {
    margin-bottom: 20px;
  }
  .cod-bundle-title {
    font-size: 13px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .cod-bundle-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cod-bundle-card {
    position: relative;
    display: flex;
    align-items: center;
    padding: 12px 14px;
    border: 1.5px solid #D1D5DB;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: #FAFAFA;
  }
  .cod-bundle-card input {
    margin-right: 12px;
    accent-color: #2563EB;
    width: 18px;
    height: 18px;
  }
  .cod-bundle-card.active {
    border-color: #2563EB;
    background: #F0F7FF;
  }
  .cod-bundle-card.popular {
    border-color: #F97316;
  }
  .cod-bundle-card.popular.active {
    background: #FFF7ED;
  }
  .cod-ribbon-popular {
    position: absolute;
    top: -10px;
    right: 14px;
    background: #F97316;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 12px;
    text-transform: uppercase;
  }
  .cod-ribbon-value {
    position: absolute;
    top: -10px;
    right: 14px;
    background: #16A34A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 12px;
    text-transform: uppercase;
  }
  .cod-bundle-details {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  .cod-bundle-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .cod-tag-free {
    background: #DCFCE7;
    color: #15803D;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .cod-tag-discount {
    background: #FEE2E2;
    color: #B91C1C;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .cod-bundle-pricing {
    text-align: right;
  }
  .cod-price {
    font-size: 15px;
    font-weight: 800;
    color: #111827;
  }
  .cod-old-price {
    font-size: 12px;
    color: #9CA3AF;
    text-decoration: line-through;
    margin-left: 4px;
  }
  .cod-form {
    border-top: 1px dashed #E5E7EB;
    padding-top: 16px;
  }
  .cod-form-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
    color: #1F2937;
    margin-bottom: 14px;
  }
  .cod-field-group {
    margin-bottom: 12px;
  }
  .cod-field-group label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #374151;
    margin-bottom: 4px;
  }
  .cod-field-group input,
  .cod-field-group select {
    width: 100%;
    padding: 10px 12px;
    font-size: 14px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .cod-field-group input:focus,
  .cod-field-group select:focus {
    border-color: #2563EB;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
  }
  .cod-phone-input {
    display: flex;
    align-items: center;
  }
  .cod-prefix {
    background: #F3F4F6;
    border: 1px solid #D1D5DB;
    border-right: none;
    padding: 10px 10px;
    font-size: 13px;
    font-weight: 700;
    color: #4B5563;
    border-radius: 6px 0 0 6px;
  }
  .cod-phone-input input {
    border-radius: 0 6px 6px 0;
  }
  .cod-field-group small {
    display: block;
    font-size: 11px;
    color: #6B7280;
    margin-top: 3px;
  }
  .cod-payment-choices {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cod-payment-opt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    padding: 8px 10px;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    cursor: pointer;
  }
  .cod-payment-opt input {
    accent-color: #16A34A;
    width: 16px;
    height: 16px;
  }
  .cod-summary-box {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 12px;
    margin: 16px 0;
  }
  .cod-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 6px;
    color: #4B5563;
  }
  .cod-free-text {
    color: #16A34A;
  }
  .cod-summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px dashed #CBD5E1;
    padding-top: 8px;
    margin-top: 6px;
    font-size: 15px;
    font-weight: 800;
    color: #0F172A;
  }
  .cod-total-price {
    font-size: 20px;
    color: #2563EB;
  }
  .cod-submit-btn {
    width: 100%;
    background: #16A34A;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 14px 16px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.1s;
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.35);
  }
  .cod-submit-btn:hover {
    background: #15803D;
    transform: translateY(-1px);
  }
  .cod-submit-btn:active {
    transform: translateY(1px);
  }
  .cod-btn-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.2px;
  }
  .cod-btn-sub {
    font-size: 12px;
    opacity: 0.9;
    margin-top: 2px;
  }
  .cod-guarantee-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
    font-size: 12px;
    color: #4B5563;
  }
  .cod-success-card {
    text-align: center;
    padding: 24px 16px;
  }
  .cod-success-icon {
    font-size: 42px;
    margin-bottom: 8px;
  }
  .cod-success-box {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 8px;
    padding: 12px;
    margin: 16px 0;
    font-size: 13px;
    color: #166534;
  }
  .cod-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #25D366;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    padding: 12px 20px;
    border-radius: 6px;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3);
  }
</style>

<script>
(function() {
  var basePrice = {{ product.price }};
  var currentQty = 1;
  var productTitle = {{ product.title | json }};

  function formatMoneyCLP(cents) {
    var num = Math.round(cents / 100);
    return '$' + num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
  }

  // Manejo de cambio de bundles
  var bundleCards = document.querySelectorAll('.cod-bundle-card');
  bundleCards.forEach(function(card) {
    card.addEventListener('click', function() {
      bundleCards.forEach(function(c) { c.classList.remove('active'); });
      card.classList.add('active');
      var radio = card.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      currentQty = parseInt(card.getAttribute('data-qty'), 10) || 1;
      var discount = parseInt(card.getAttribute('data-discount'), 10) || 0;

      var totalCents = basePrice * currentQty;
      if (discount > 0) {
        totalCents = Math.round(totalCents * (1 - (discount / 100)));
      }

      var qtyText = currentQty + (currentQty === 1 ? ' unidad' : ' unidades');
      var qtyEl = document.getElementById('cod-summary-qty');
      if (qtyEl) qtyEl.textContent = qtyText;

      var totalDisplay = document.getElementById('cod-total-display');
      if (totalDisplay) totalDisplay.textContent = formatMoneyCLP(totalCents);
    });
  });

  // Envío del pedido COD
  window.submitChileCodOrder = function() {
    var name = document.getElementById('cod_name').value.trim();
    var phone = document.getElementById('cod_phone').value.trim();
    var region = document.getElementById('cod_region').value;
    var city = document.getElementById('cod_city').value.trim();
    var address = document.getElementById('cod_address').value.trim();
    var paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value || 'Efectivo al recibir';
    var totalText = document.getElementById('cod-total-display').textContent;

    if (!name || !phone || !region || !city || !address) {
      alert('Por favor completa todos los campos requeridos para coordinar tu entrega.');
      return;
    }

    var submitBtn = document.getElementById('cod-submit-btn');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Procesando orden...</span>';
    }

    // Mensaje para confirmación en WhatsApp
    var waMessage = "¡Hola VELTRO! Acabo de hacer un pedido con Pago Contra Entrega en www.veltro.cl:%0A%0A"
      + "📦 *Producto:* " + encodeURIComponent(productTitle) + "%0A"
      + "🔢 *Cantidad:* " + currentQty + " unid.%0A"
      + "💰 *Total a pagar:* " + encodeURIComponent(totalText) + "%0A"
      + "💵 *Método de Pago:* " + encodeURIComponent(paymentMethod) + "%0A"
      + "👤 *Nombre:* " + encodeURIComponent(name) + "%0A"
      + "📞 *Teléfono:* +56 " + encodeURIComponent(phone) + "%0A"
      + "📍 *Región:* " + encodeURIComponent(region) + "%0A"
      + "🏙️ *Comuna:* " + encodeURIComponent(city) + "%0A"
      + "🏠 *Dirección:* " + encodeURIComponent(address) + "%0A%0A"
      + "¿Me pueden confirmar cuándo sale el despacho con Blue Express / Starken? ¡Muchas gracias!";

    var waLink = "https://wa.me/56912345678?text=" + waMessage;

    // Ocultar formulario y mostrar confirmación
    var formEl = document.getElementById('cod-order-form');
    var successEl = document.getElementById('cod-success-message');
    var waBtn = document.getElementById('cod-whatsapp-confirm-link');

    if (formEl) formEl.style.display = 'none';
    if (successEl) successEl.style.display = 'block';
    if (waBtn) waBtn.href = waLink;

    // También agregar al carrito de Shopify en segundo plano para registrar el evento
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: {{ product.selected_or_first_available_variant.id | default: product.variants.first.id }},
        quantity: currentQty,
        properties: {
          'Modalidad': 'Pago Contra Entrega (COD)',
          'Nombre Cliente': name,
          'Teléfono': '+56 ' + phone,
          'Región': region,
          'Comuna': city,
          'Dirección': address,
          'Medio Pago': paymentMethod
        }
      })
    }).catch(function(e) { console.log('Cart add notice', e); });
  };
})();
</script>
